@startuml Flowforge_Class_Diagram
' Classic UML class diagram — overview with key detail
' Render: plantuml docs/diagrams/class-diagram.puml
' Or paste @startuml block into https://www.plantuml.com/plantuml

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  ArrowColor #000000
}

left to right direction

' ── Domain ──────────────────────────────────────────────────

class User {
  +id: String
  +email: String
  +name: String
  -role: UserRole
  -banned: Boolean
  --
  +signIn()
  +signUp()
}

class Workflow {
  +id: String
  +name: String
  -userId: String
  --
  +save()
  +run()
}

class Node {
  +id: String
  +name: String
  +type: NodeType
  -position: Json
  -data: Json
  -credentialId: String
}

class Connection {
  +id: String
  -workflowId: String
  -fromNodeId: String
  -toNodeId: String
  -fromOutput: String
  -toInput: String
}

class Credential {
  +id: String
  +name: String
  -value: String
  +type: CredentialType
  -userId: String
}

class Execution {
  +id: String
  -workflowId: String
  -status: ExecutionStatus
  -inngestEventId: String
  -output: Json
  -startedAt: DateTime
  -completedAt: DateTime
}

class WorkflowExecutionSnapshot {
  -workflowId: String
  -phase: String
  -nodeStatuses: Json
}

class CalendarEvent {
  +id: String
  -userId: String
  +title: String
  -startAt: DateTime
  -endAt: DateTime
  -timezone: String
}

class EventReminder {
  +id: String
  -eventId: String
  -workflowId: String
  -nodeId: String
  -offsetValue: Int
  -offsetUnit: ReminderUnit
  -direction: ReminderDirection
  -fireAt: DateTime
  -enabled: Boolean
}

class ScheduleTrigger {
  +id: String
  -workflowId: String
  -nodeId: String
  -cronExpression: String
  -timezone: String
  -enabled: Boolean
  -nextRunAt: DateTime
}

class TriggerSetting {
  -kind: TriggerKind
  -enabled: Boolean
}

' ── API (tRPC) ───────────────────────────────────────────────

class AppRouter {
  +admin: AdminRouter
  +workflows: WorkflowsRouter
  +credentials: CredentialsRouter
  +executions: ExecutionsRouter
  +calendar: CalendarRouter
  +aiWorkflow: AiWorkflowRouter
}

class tRPCInit {
  +baseProcedure
  +protectedProcedure
  +premiumProcedure
  +adminProcedure
}

class WorkflowsRouter {
  --
  +create()
  +update()
  +remove()
  +getOne()
  +execute()
}

class CredentialsRouter {
  --
  +create()
  +update()
  +remove()
  +getMany()
}

class ExecutionsRouter {
  --
  +getOne()
  +getMany()
}

class CalendarRouter {
  --
  +create()
  +update()
  +remove()
  +getMany()
}

class AdminRouter {
  --
  +users.list()
  +users.setRole()
  +triggers.list()
  +triggers.update()
}

class AiWorkflowRouter {
  --
  +plan()
  +generate()
}

' ── AI Workflow ─────────────────────────────────────────────

class PlannerService {
  --
  +planWorkflow()
}

class NodeCatalog {
  +NODE_CATALOG: NodeCapability[]
  --
  +getNodeCapability()
}

class PlanToGraph {
  --
  +planToGraph()
  +validateGraph()
}

' ── Execution ───────────────────────────────────────────────

class ExecuteWorkflowFunction {
  +workflowId: String
  -inngestEventId: String
  --
  +run()
  +onFailure()
}

class SchedulerScanFunction {
  --
  +runScan()
  +runReminderScan()
}

class ExecuteGraph {
  --
  +executeGraph()
}

interface NodeExecutor {
  +execute(params): WorkflowContext
}

class ExecutorRegistry {
  -executorRegistry: Record
  --
  +getExecutor(type)
}

class ExecutionStatusStore {
  --
  +resetCachedExecution()
  +setCachedNodeStatus()
  +setCachedExecutionPhase()
  +getCachedExecution()
}

class PublishExecutionEvent {
  --
  +publishExecutionStarted()
  +publishExecutionCompleted()
  +publishNodeStatus()
}

class TriggerEnforcement {
  --
  +assertTriggerEnabled()
  +assertWorkflowTriggersEnabled()
}

class Encryption {
  -cryptr: Cryptr
  --
  +encrypt()
  +decrypt()
}

' ── Domain associations ───────────────────────────────────────

User "1" -- "0..*" Workflow
User "1" -- "0..*" Credential
User "1" -- "0..*" CalendarEvent

Workflow "1" -- "1..*" Node
Workflow "1" -- "0..*" Connection
Workflow "1" -- "0..*" Execution
Workflow "1" -- "0..1" WorkflowExecutionSnapshot
Workflow "1" -- "0..*" ScheduleTrigger
Workflow "1" -- "0..*" EventReminder

Node "1" -- "0..*" Connection : from
Node "1" -- "0..*" Connection : to
Node "0..1" -- "0..*" Credential : uses

CalendarEvent "1" -- "0..*" EventReminder
EventReminder "0..*" -- "1" Workflow

' ── API associations ────────────────────────────────────────

AppRouter "1" *-- "1" tRPCInit
AppRouter "1" *-- "1" WorkflowsRouter
AppRouter "1" *-- "1" CredentialsRouter
AppRouter "1" *-- "1" ExecutionsRouter
AppRouter "1" *-- "1" CalendarRouter
AppRouter "1" *-- "1" AdminRouter
AppRouter "1" *-- "1" AiWorkflowRouter

WorkflowsRouter "1" -- "0..*" Workflow
WorkflowsRouter "1" -- "0..*" ExecuteWorkflowFunction
CredentialsRouter "1" -- "0..*" Credential
CredentialsRouter "1" -- "1" Encryption
ExecutionsRouter "1" -- "0..*" Execution
CalendarRouter "1" -- "0..*" CalendarEvent
AdminRouter "1" -- "0..*" TriggerSetting

AiWorkflowRouter "1" -- "1" PlannerService
AiWorkflowRouter "1" -- "1" PlanToGraph
PlannerService "1" -- "1" NodeCatalog
PlanToGraph "1" -- "0..*" Workflow

' ── Execution associations ──────────────────────────────────

ExecuteWorkflowFunction "1" -- "1..*" Node
ExecuteWorkflowFunction "1" -- "1" ExecuteGraph
ExecuteWorkflowFunction "1" -- "1" ExecutorRegistry
ExecuteWorkflowFunction "1" -- "1" TriggerEnforcement
ExecuteWorkflowFunction "1" -- "1" PublishExecutionEvent
ExecuteWorkflowFunction "1" -- "0..1" Execution

SchedulerScanFunction "1" -- "0..*" ScheduleTrigger
SchedulerScanFunction "1" -- "0..*" EventReminder
SchedulerScanFunction "1" -- "0..*" ExecuteWorkflowFunction

ExecuteGraph "1" -- "1..*" ExecutorRegistry
ExecutorRegistry "1" -- "1..*" NodeExecutor
PublishExecutionEvent "1" -- "1" ExecutionStatusStore
ExecutionStatusStore "1" -- "0..1" WorkflowExecutionSnapshot
TriggerEnforcement "1" -- "0..*" TriggerSetting

' ── Layout hints ──────────────────────────────────────────────

ExecutorRegistry -[hidden]right- ExecutionStatusStore
ExecutionStatusStore -[hidden]right- PublishExecutionEvent
ExecutorRegistry -[hidden]up- ExecuteGraph
PublishExecutionEvent -[hidden]up- ExecuteWorkflowFunction

Credential -[hidden]down- Encryption
CredentialsRouter -[hidden]down- Encryption

PlannerService -[hidden]right- PlanToGraph
NodeCatalog -[hidden]down- PlannerService

CalendarEvent -[hidden]right- EventReminder
ScheduleTrigger -[hidden]down- EventReminder

@enduml
